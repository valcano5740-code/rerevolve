{
  "name": "rerevolve-quota-manager",
  "displayName": "ReRevolve Quota Manager",
  "description": "Antigravity 다중 계정 Claude 쿼터 관리 확장프로그램",
  "version": "8.4.0",
  "publisher": "rerevolve",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rerevolve-sidebar",
          "title": "ReRevolve",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "rerevolve-sidebar": [
        {
          "type": "webview",
          "id": "rerevolve.quotaPanel",
          "name": "Quota Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "rerevolve.refreshAll",
        "title": "ReRevolve: 전체 새로고침",
        "icon": "$(sync)"
      },
      {
        "command": "rerevolve.addAccount",
        "title": "ReRevolve: 계정 추가",
        "icon": "$(add)"
      },
      {
        "command": "rerevolve.captureToken",
        "title": "ReRevolve: 현재 계정 토큰 캡처"
      },
      {
        "command": "rerevolve.reloadAntigravity",
        "title": "ReRevolve: Antigravity 재시작",
        "icon": "$(zap)"
      },
      {
        "command": "rerevolve.toggleAutoAccept",
        "title": "ReRevolve: Auto-Accept 토글",
        "icon": "$(rocket)"
      },
      {
        "command": "rerevolve.toggleAutoRetry",
        "title": "ReRevolve: Auto-Retry 토글",
        "icon": "$(debug-restart)"
      },
      {
        "command": "rerevolve.saveSnapshot",
        "title": "ReRevolve: 현재 계정 스냅샷 저장"
      },
      {
        "command": "rerevolve.switchAccount",
        "title": "ReRevolve: 계정 전환"
      },
      {
        "command": "rerevolve.revertAutoRun",
        "title": "ReRevolve: Auto-Run 패치 되돌리기"
      },
      {
        "command": "rerevolve.autoRunStatus",
        "title": "ReRevolve: Auto-Run 패치 상태"
      },
      {
        "command": "rerevolve.togglePrewarm",
        "title": "ReRevolve: Pre-warm 토글",
        "icon": "$(flame)"
      }
    ],
    "keybindings": [
      {
        "command": "rerevolve.toggleAutoAccept",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a"
      },
      {
        "command": "rerevolve.toggleAutoRetry",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rerevolve.refreshAll",
          "when": "view == rerevolve.quotaPanel",
          "group": "navigation@1"
        },
        {
          "command": "rerevolve.reloadAntigravity",
          "when": "view == rerevolve.quotaPanel",
          "group": "navigation@2"
        },
        {
          "command": "rerevolve.addAccount",
          "when": "view == rerevolve.quotaPanel",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "ReRevolve",
      "properties": {
        "rerevolve.autoAcceptEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Auto-Accept 활성화 상태 (모든 세션 동기화)"
        },
        "rerevolve.autoRetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Auto-Retry 활성화 상태: Retry/Continue 복구 버튼만 자동 클릭"
        },
        "rerevolve.prewarmEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Pre-warm (Kickstart) 활성화: 모든 계정의 쿨타임을 사전 시작"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "tsc -watch -p ./",
    "package": "node esbuild.js --production && vsce package --no-dependencies --allow-missing-repository && node sync-gd-release.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "sql.js": "^1.13.0",
    "ws": "^8.20.0"
  }
}